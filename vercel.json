{
  "version": 2,
  "buildCommand": "npm install",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/$",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(Mobile|iPhone|iPad|iPod|Android|BlackBerry|IEMobile|Opera Mini).*" }
      ],
      "dest": "/desktop.html"
    },
    {
      "src": "^/(subastas|market|concesionarios|pagos|vehiculos|publicar)/?$",
      "missing": [
        { "type": "header", "key": "user-agent", "value": ".*(Mobile|iPhone|iPad|iPod|Android|BlackBerry|IEMobile|Opera Mini).*" }
      ],
      "dest": "/desktop.html"
    },
    { "handle": "filesystem" },
    { "src": "^/subastas/?$", "dest": "/index.html" },
    { "src": "^/market/?$", "dest": "/index.html" },
    { "src": "^/concesionarios/?$", "dest": "/index.html" },
    { "src": "^/pagos/?$", "dest": "/index.html" },
    { "src": "^/vehiculos/?$", "dest": "/index.html" },
    { "src": "^/publicar/?$", "dest": "/index.html" }
  ]
}

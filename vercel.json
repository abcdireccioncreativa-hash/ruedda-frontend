{
  "version": 2,
  "buildCommand": "npm install && node build.js",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/_rd/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(splash|assets)/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/assets/(fonts|inline)/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/apple-app-site-association$",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "^/app/?$",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex"
      },
      "dest": "/app.html"
    },
    {
      "src": "^/control/?$",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "dest": "/control.html"
    },
    {
      "src": "^/api/office-login$",
      "dest": "/api/admin-user?office=login"
    },
    {
      "src": "^/api/office-stats$",
      "dest": "/api/admin-user?office=stats"
    },
    {
      "src": "^/office/?$",
      "dest": "https://ruedda-office.vercel.app/office"
    },
    {
      "src": "^/office/(.*)$",
      "dest": "https://ruedda-office.vercel.app/office/$1"
    },
    {
      "src": "^/hub/?$",
      "dest": "https://ruedda-hub.vercel.app/hub/"
    },
    {
      "src": "^/hub/(.*)$",
      "dest": "https://ruedda-hub.vercel.app/hub/$1"
    },
    {
      "src": "^/repuestos$",
      "status": 308,
      "headers": {
        "Location": "/repuestos/"
      }
    },
    {
      "src": "^/$",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Mobile|iPhone|iPad|iPod|Android|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/desktop.html"
    },
    {
      "src": "^/$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/(subastas|market|concesionarios|pagos|vehiculos|publicar)/?$",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Mobile|iPhone|iPad|iPod|Android|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/desktop.html"
    },
    {
      "src": "^/vendor/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/subastas/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/market/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/concesionarios/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/pagos/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/vehiculos/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/publicar/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    }
  ]
}

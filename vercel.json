{
  "version": 2,
  "buildCommand": "npm install && node build.js",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/Downloads/(.*)$",
      "status": 404,
      "dest": "/404"
    },
    {
      "src": "^/_rd/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(splash|assets)/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/assets/(fonts|inline)/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "^/\\.well-known/apple-app-site-association$",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "^/app/?$",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex"
      },
      "dest": "/app.html"
    },
    {
      "src": "^/control/?$",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "dest": "/control.html"
    },
    {
      "src": "^/api/office-login$",
      "dest": "/api/admin-user?office=login"
    },
    {
      "src": "^/api/office-stats$",
      "dest": "/api/admin-user?office=stats"
    },
    {
      "src": "^/api/ai-describe$",
      "dest": "/api/admin-user?ai=describe"
    },
    {
      "src": "^/api/postulacion$",
      "dest": "/api/admin-user?postulacion=1"
    },
    {
      "src": "^/api/noticias$",
      "dest": "/api/admin-user?news=1"
    },
    {
      "src": "^/office/?$",
      "dest": "https://ruedda-office.vercel.app/office"
    },
    {
      "src": "^/office/(.*)$",
      "dest": "https://ruedda-office.vercel.app/office/$1"
    },
    {
      "src": "^/colombia/?$",
      "dest": "/waitlist/colombia.html"
    },
    {
      "src": "^/colombia/(.*)$",
      "dest": "/waitlist/colombia.html"
    },
    {
      "src": "^/canada/?$",
      "dest": "/waitlist/canada.html"
    },
    {
      "src": "^/canada/(.*)$",
      "dest": "/waitlist/canada.html"
    },
    {
      "src": "^/avalta/?$",
      "dest": "https://avalta-web.vercel.app/avalta"
    },
    {
      "src": "^/avalta/(.*)$",
      "dest": "https://avalta-web.vercel.app/avalta/$1"
    },
    {
      "src": "^/hub/?$",
      "dest": "https://ruedda-hub.vercel.app/hub/"
    },
    {
      "src": "^/hub/(.*)$",
      "dest": "https://ruedda-hub.vercel.app/hub/$1"
    },
    {
      "src": "^/chrono/?$",
      "dest": "https://ruedda-chrono.vercel.app/chrono"
    },
    {
      "src": "^/chrono/(.*)$",
      "dest": "https://ruedda-chrono.vercel.app/chrono/$1"
    },
    {
      "src": "^/linktree/?$",
      "dest": "https://ruedda-linktree.vercel.app/linktree/"
    },
    {
      "src": "^/repuestos$",
      "status": 308,
      "headers": {
        "Location": "/repuestos/"
      }
    },
    {
      "src": "^/(index\\.html|desktop\\.html)?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Applebot|Googlebot|bingbot|Iframely|Embedly|vkShare|SignalBot|Viber).*"
        },
        {
          "type": "query",
          "key": "market"
        }
      ],
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/api/admin-user?og=1"
    },
    {
      "src": "^/(index\\.html|desktop\\.html)?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Applebot|Googlebot|bingbot|Iframely|Embedly|vkShare|SignalBot|Viber).*"
        },
        {
          "type": "query",
          "key": "auction"
        }
      ],
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/api/admin-user?og=1"
    },
    {
      "src": "^/$",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Mobile|iPhone|iPad|iPod|Android|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/desktop.html"
    },
    {
      "src": "^/$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/(subastas|market|concesionarios|pagos|vehiculos|publicar)/?$",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Mobile|iPhone|iPad|iPod|Android|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/desktop.html"
    },
    {
      "src": "^/vendor/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/subastas/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/market/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/concesionarios/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/pagos/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/vehiculos/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/publicar/?$",
      "headers": {
        "Vary": "User-Agent"
      },
      "dest": "/index.html"
    }
  ]
}
